---
import BaseLayout from "../layouts/BaseLayout.astro";
import RankingTable from "../components/RankingTable.astro";
import { loadLatestData } from "../lib/data";

const pageData = await loadLatestData();
---

<BaseLayout title="Language Trends — GitHub Repo Rankings">
  {
    pageData ? (
      <RankingTable
        languages={pageData.data.languages}
        totalRepos={pageData.data.total_repos}
        updatedAt={pageData.updatedAt}
      />
    ) : (
      <div class="text-center space-y-6">
        <!-- Page title -->
        <div class="space-y-2">
          <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl lg:text-5xl">
            Language Trends
          </h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Languages ranked by new repositories with <span class="font-semibold text-gray-700 dark:text-gray-300">&gt;100 stars</span> on GitHub in the past year
          </p>
        </div>

        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-20">
          <div class="rounded-2xl border-2 border-dashed border-gray-200 dark:border-gray-800 p-12 max-w-md">
            <div class="text-5xl mb-4">📊</div>
            <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">
              No data yet
            </h2>
            <p class="text-sm text-gray-400 dark:text-gray-500 leading-relaxed">
              Run the data collection script to populate rankings:<br />
              <code class="inline-block mt-2 rounded-md bg-gray-100 px-3 py-1.5 text-xs font-mono text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                uv run python scripts/fetch_trends.py
              </code>
            </p>
          </div>
        </div>
      </div>
    )
  }
</BaseLayout>
